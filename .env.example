# Public origin of the site (canonical URLs, sitemap, RSS). No trailing slash.
NEXT_PUBLIC_SITE_URL=

# Blog admin (/admin). Server-only.
ADMIN_PASSWORD=
# At least 32 random characters; signs the admin session cookie.
ADMIN_SESSION_SECRET=

# Where the admin saves posts and images: "local" (files in this repo) or "github" (commits via the GitHub API).
# Defaults to "local" outside production and "github" in production.
BLOG_STORAGE=
# Only for BLOG_STORAGE=github. Fine-grained token with Contents read/write on the repo. Server-only.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=
